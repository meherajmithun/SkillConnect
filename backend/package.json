{
  "name": "@skillconnect/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js && prettier --check src public test scripts",
    "format": "prettier --write src public test scripts",
    "migrate": "node --env-file-if-exists=../.env src/commands.js migrate",
    "seed": "node --env-file-if-exists=../.env src/commands.js seed",
    "admin": "node --env-file-if-exists=../.env src/commands.js admin",
    "import-legacy": "node --env-file-if-exists=../.env src/commands.js import-legacy",
    "push-worker": "node --env-file-if-exists=../.env src/push-worker.js --watch"
  },
  "dependencies": {
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
