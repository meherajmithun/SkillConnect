# Docker Compose reads this file after copying it to .env.
# For local Python commands, export these variables in your shell first.
DEBUG=true
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
POSTGRES_PASSWORD=replace-with-a-strong-database-password
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:8080
DEMO_PAYMENTS=false
# For a local Python process using PostgreSQL:
# POSTGRES_DB=skillconnect
# POSTGRES_USER=skillconnect
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Optional push worker (never commit the credential file):
# FIREBASE_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Email codes print in the backend terminal by default during local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# To deliver real email, use django.core.mail.backends.smtp.EmailBackend and fill these:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SkillConnect <noreply@skillconnect.local>

# SSLCommerz hosted checkout. Leave credentials empty to keep manual payments.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Origin of this backend, without a trailing /api/. Live callbacks require reachable HTTPS.
PAYMENT_CALLBACK_BASE_URL=
# For Docker's optional push profile, put credentials in backend/credentials/:
# FIREBASE_CREDENTIALS=/app/credentials/firebase-service-account.json
