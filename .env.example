# Node commands load this file after copying it to .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional in local development; exact hosts required for production:
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Behind a trusted HTTPS proxy, set TRUST_PROXY=1 and your HTTPS origin:
TRUST_PROXY=
PUBLIC_ORIGIN=
# PostgreSQL: use DATABASE_URL or the individual settings below.
DATABASE_URL=
DATABASE_SSL=false
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# POSTGRES_DB=skillconnect
# POSTGRES_USER=skillconnect
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# SQLite is local-only by default: backend/data/skillconnect.sqlite3
# DATA_DIR=/absolute/path/to/persistent/data
# MEDIA_DIR=/absolute/path/to/persistent/media
# MEDIA_BASE_URL=https://your-server.example/media/
DEMO_PAYMENTS=false
EMAIL_MODE=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SECURE=false
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SkillConnect <noreply@skillconnect.local>
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
PAYMENT_CALLBACK_BASE_URL=
FIREBASE_CREDENTIALS=
